[node name="BuildHeader" type="Label" parent="Panel/VBox/Scroll/Content/MarginWrap/Sections"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.75, 0.3, 1.0)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 22
text = "🔨  Building"

[node name="BuildText" type="Label" parent="Panel/VBox/Scroll/Content/MarginWrap/Sections"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.8, 0.7, 1.0)
theme_override_fonts/font = ExtResource("3_cardo")
theme_override_font_sizes/font_size = 15
autowrap_mode = 3
text = "Click the Build button (or press B) to open the build menu. Place buildings on the right side of the map. The Castle must be placed first — it anchors your defenses. Buildings cost Gold, Wood, or Meat to construct and can be upgraded by clicking them."

[node name="Div2" type="ColorRect" parent="Panel/VBox/Scroll/Content/MarginWrap/Sections"]
custom_minimum_size = Vector2(0, 1)
layout_mode = 2
color = Color(0.4, 0.25, 0.05, 0.5)

[node name="UnitsHeader" type="Label" parent="Panel/VBox/Scroll/Content/MarginWrap/Sections"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.75, 0.3, 1.0)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 22
text = "⚔  Units"

[node name="UnitsText" type="Label" parent="Panel/VBox/Scroll/Content/MarginWrap/Sections"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.8, 0.7, 1.0)
theme_override_fonts/font = ExtResource("3_cardo")
theme_override_font_sizes/font_size = 15
autowrap_mode = 3
text = "Left-click to select units. Drag to box-select a group. Double-click a unit to select all of that type. Right-click to move selected units. Hold right-click and drag to rotate the formation before releasing.\n\nUnit types:\n• Warrior — tough melee fighter\n• Lancer — heavy melee with long reach\n• Archer — ranged attacker, keep behind melee\n• Monk — heals allies and attacks at range\n• Pawn — gathers resources"

[node name="Div3" type="ColorRect" parent="Panel/VBox/Scroll/Content/MarginWrap/Sections"]
custom_minimum_size = Vector2(0, 1)
layout_mode = 2
color = Color(0.4, 0.25, 0.05, 0.5)

[node name="FormHeader" type="Label" parent="Panel/VBox/Scroll/Content/MarginWrap/Sections"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.75, 0.3, 1.0)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 22
