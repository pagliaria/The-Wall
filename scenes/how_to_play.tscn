theme_override_fonts/font = ExtResource("3_cardo")
theme_override_font_sizes/font_size = 15
autowrap_mode = 3
text = "Gold, Wood, and Meat are gathered by Pawns. Right-click a resource node to assign a Pawn to gather from it. Resources respawn over time. Gold is used for most things, Wood for buildings, Meat for training units."

