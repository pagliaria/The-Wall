[node name="FormText" type="Label" parent="Panel/VBox/Scroll/Content/MarginWrap/Sections"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.8, 0.7, 1.0)
theme_override_fonts/font = ExtResource("3_cardo")
theme_override_font_sizes/font_size = 15
autowrap_mode = 3
text = "When multiple units are selected, choose a formation from the selection panel: Line, Wedge, Box, or Flanks. Adjust spacing with Tight, Normal, or Loose. Tougher units are automatically placed at the front."

[node name="Div4" type="ColorRect" parent="Panel/VBox/Scroll/Content/MarginWrap/Sections"]
