[node name="GoalText" type="Label" parent="Panel/VBox/Scroll/Content/MarginWrap/Sections"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.8, 0.7, 1.0)
theme_override_fonts/font = ExtResource("3_cardo")
theme_override_font_sizes/font_size = 15
autowrap_mode = 3
text = "Defend your castle through 15 waves of enemies. Survive all waves to win. If your units and hired allies are all defeated during a wave, you lose."

